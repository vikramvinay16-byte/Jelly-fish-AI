
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">
<title>Zerotoin Medical AI</title>

<style>
:root {
  --green: #087f68;
  --green-light: #e8f6f1;
  --bg: #ffffff;
  --sidebar: #f7f9f8;
  --text: #202d2a;
  --muted: #718078;
  --border: #e1e8e4;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}
button, input, textarea { font: inherit; }
button { cursor: pointer; }
.app { min-height: 100vh; display: flex; flex-direction: column; }
.topbar {
  height: 64px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 18px;
  gap: 12px;
  flex-shrink: 0;
}
.brand-icon {
  background: var(--green);
  color: white;
  height: 38px;
  width: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  font-size: 22px;
  font-weight: bold;
}
.brand-name { font-weight: bold; font-size: 18px; }
.brand-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }
.top-spacer { flex: 1; }
.privacy-top { color: var(--muted); font-size: 12px; }
.menu-button {
  display: none;
  border: 0;
  background: transparent;
  font-size: 23px;
  padding: 6px;
}
.layout { display: flex; flex: 1; min-height: 0; }
.sidebar {
  width: 235px;
  flex-shrink: 0;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
}
.side-button {
  border: 0;
  background: transparent;
  color: #46564f;
  text-align: left;
  border-radius: 9px;
  padding: 12px;
  margin-bottom: 5px;
  font-size: 14px;
  display: flex;
  gap: 10px;
  align-items: center;
}
.side-button:hover, .side-button.active {
  background: var(--green-light);
  color: var(--green);
}
.side-heading {
  color: var(--muted);
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
  margin: 26px 10px 10px;
}
.history-item {
  background: transparent;
  border: 0;
  text-align: left;
  color: #5b6b64;
  padding: 10px;
  font-size: 13px;
  border-radius: 8px;
}
.history-item:hover { background: #edf2ef; }
.side-bottom {
  margin-top: auto;
  padding: 14px 10px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.6;
  border-top: 1px solid var(--border);
}
.workspace {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64px);
}
.chat-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 34px 18px 20px;
}
.chat-inner { max-width: 760px; margin: 0 auto; width: 100%; }
.welcome { text-align: center; padding: 28px 0 18px; }
.welcome-logo {
  width: 64px;
  height: 64px;
  background: var(--green-light);
  color: var(--green);
  border-radius: 22px;
  margin: 0 auto 20px;
  display: grid;
  place-items: center;
  font-size: 30px;
}
.welcome h1 { font-size: 29px; margin: 0 0 12px; }
.welcome p {
  max-width: 510px;
  margin: 0 auto;
  line-height: 1.7;
  color: var(--muted);
  font-size: 14px;
}
.features {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 28px 0 22px;
}
.feature {
  border: 1px solid var(--border);
  padding: 17px;
  border-radius: 13px;
  background: white;
}
.feature-icon { font-size: 23px; margin-bottom: 10px; }
.feature strong { display: block; font-size: 14px; margin-bottom: 6px; }
.feature span { font-size: 12px; line-height: 1.5; color: var(--muted); }
.prompt-title { text-align: center; font-size: 12px; color: var(--muted); margin: 22px 0 12px; }
.prompts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.prompt {
  border: 1px solid var(--border);
  border-radius: 20px;
  background: white;
  padding: 10px 13px;
  font-size: 12px;
  color: #46564f;
}
.prompt:hover { border-color: var(--green); color: var(--green); }
.message { display: flex; gap: 12px; margin: 20px 0; align-items: flex-start; }
.message.user { justify-content: flex-end; }
.avatar {
  width: 32px;
  height: 32px;
  border-radius: 11px;
  background: var(--green);
  color: white;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 15px;
  font-weight: bold;
}
.bubble {
  max-width: min(88%, 650px);
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 15px;
  line-height: 1.7;
  font-size: 14px;
  overflow-wrap: anywhere;
}
.user .bubble { background: var(--green-light); border-color: transparent; }
.bubble h3 { font-size: 16px; margin: 0 0 10px; }
.bubble p { margin: 7px 0; }
.bubble ul { padding-left: 20px; }
.attachment {
  font-size: 12px;
  background: #f4f7f5;
  border-radius: 8px;
  padding: 8px;
  margin-bottom: 8px;
}
.composer-area {
  padding: 10px 16px 14px;
  background: white;
}
.composer { max-width: 760px; margin: auto; }
.file-preview {
  display: none;
  font-size: 12px;
  color: var(--muted);
  padding: 8px 4px;
}
.input-box {
  border: 1px solid #d5e0da;
  border-radius: 20px;
  padding: 9px 10px;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  box-shadow: 0 2px 10px #102c2808;
}
.input-box:focus-within { border-color: #83b9a8; }
#messageInput {
  flex: 1;
  resize: none;
  border: 0;
  outline: none;
  background: transparent;
  min-width: 0;
  max-height: 140px;
  padding: 9px 3px;
  font-size: 14px;
  line-height: 1.5;
}
.icon-button {
  width: 37px;
  height: 37px;
  flex-shrink: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #53675d;
  font-size: 19px;
  display: grid;
  place-items: center;
}
.send-button { background: var(--green); color: white; }
.send-button:hover { background: #066c59; }
.disclaimer {
  text-align: center;
  max-width: 760px;
  margin: 10px auto 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.5;
}
.hidden { display: none !important; }
@media (min-width: 1000px) {
  .chat-scroll { padding-top: 45px; }
}
@media (max-width: 650px) {
  .topbar { height: 58px; padding: 0 11px; }
  .menu-button { display: block; }
  .brand-icon { width: 34px; height: 34px; font-size: 19px; }
  .brand-name { font-size: 15px; }
  .brand-sub { font-size: 10px; }
  .privacy-top { display: none; }
  .sidebar {
    position: fixed;
    top: 58px;
    bottom: 0;
    left: 0;
    z-index: 10;
    box-shadow: 8px 0 24px #00000010;
    transform: translateX(-105%);
    transition: transform .2s ease;
  }
  .sidebar.open { transform: translateX(0); }
  .workspace { min-height: calc(100vh - 58px); }
  .chat-scroll { padding: 20px 12px; }
  .welcome { padding-top: 30px; }
  .welcome h1 { font-size: 24px; }
  .welcome p { font-size: 13px; }
  .features { gap: 8px; margin-top: 22px; }
  .feature { padding: 12px; }
  .bubble { max-width: 92%; padding: 12px; font-size: 13px; }
  .composer-area { padding: 8px 10px 10px; }
}
</style>
</head>

<body>
<div class="app">

  <header class="topbar">
    <button class="menu-button" id="menuButton" aria-label="Toggle sidebar">☰</button>
    <div class="brand-icon">✚</div>
    <div>
      <div class="brand-name">Zerotoin Medical AI</div>
      <div class="brand-sub">Understand your medical reports</div>
    </div>
    <div class="top-spacer"></div>
    <div class="privacy-top">♢ Educational health assistant</div>
  </header>

  <div class="layout">

    <aside class="sidebar" id="sidebar">
      <button class="side-button active" id="newChat">＋ New chat</button>
      <button class="side-button" id="uploadButton">▧ Upload report</button>
      <button class="side-button" id="myReports">▤ My reports</button>

      <div class="side-heading">Recent chats</div>
      <div id="history">
        <button class="history-item">Understanding blood tests</button>
        <button class="history-item">About glucose results</button>
        <button class="history-item">Learn about CBC</button>
      </div>

      <div class="side-bottom">
        <strong>🔒 Your privacy matters</strong><br>
        This local demo does not upload your report to a server.
        <br><br>Zerotoin Medical AI · Prototype
      </div>
    </aside>

    <section class="workspace">
      <div class="chat-scroll" id="chatScroll">
        <div class="chat-inner" id="chat">

          <div class="welcome" id="welcome">
            <div class="welcome-logo">✚</div>
            <h1>How can I help you today?</h1>
            <p>
              Ask questions about laboratory tests or select a report.
              Learn what common medical terms and test results mean
              in simple language.
            </p>
          </div>

          <div class="features" id="features">
            <div class="feature">
              <div class="feature-icon">📄</div>
              <strong>Medical reports</strong>
              <span>Choose a report from your device.</span>
            </div>
            <div class="feature">
              <div class="feature-icon">🔬</div>
              <strong>Understand results</strong>
              <span>Learn about tests and reference ranges.</span>
            </div>
            <div class="feature">
              <div class="feature-icon">💡</div>
              <strong>Simple explanations</strong>
              <span>Explore common medical terminology.</span>
            </div>
            <div class="feature">
              <div class="feature-icon">🛡️</div>
              <strong>Health education</strong>
              <span>Learn safely without self-diagnosing.</span>
            </div>
          </div>

          <div class="prompt-title" id="promptTitle">Try asking a question</div>
          <div class="prompts" id="prompts">
            <button class="prompt">What is a CBC test?</button>
            <button class="prompt">Explain blood glucose</button>
            <button class="prompt">What is a thyroid test?</button>
            <button class="prompt">What is a reference range?</button>
          </div>

        </div>
      </div>

      <div class="composer-area">
        <div class="composer">
          <div class="file-preview" id="filePreview"></div>

          <div class="input-box">
            <button class="icon-button" id="attachButton" aria-label="Attach report">＋</button>
            <input type="file" id="fileInput" class="hidden"
              accept=".pdf,.png,.jpg,.jpeg,.txt">
            <textarea id="messageInput" rows="1"
              placeholder="Ask Zerotoin Medical AI..."></textarea>
            <button class="icon-button send-button" id="sendButton"
              aria-label="Send message">↑</button>
          </div>

          <div class="disclaimer">
            For educational purposes only. This demo does not provide
            diagnoses or treatment advice. Consult a qualified healthcare
            professional about your results. Uploaded files are not
            automatically analyzed in this prototype.
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
const chat = document.getElementById("chat");
const welcome = document.getElementById("welcome");
const features = document.getElementById("features");
const prompts = document.getElementById("prompts");
const promptTitle = document.getElementById("promptTitle");
const input = document.getElementById("messageInput");
const fileInput = document.getElementById("fileInput");
const filePreview = document.getElementById("filePreview");
const chatScroll = document.getElementById("chatScroll");
const sidebar = document.getElementById("sidebar");

let selectedFile = null;

function hideWelcome() {
  welcome.classList.add("hidden");
  features.classList.add("hidden");
  prompts.classList.add("hidden");
  promptTitle.classList.add("hidden");
}

function scrollBottom() {
  chatScroll.scrollTop = chatScroll.scrollHeight;
}

function addMessage(text, type, fileName) {
  hideWelcome();

  const row = document.createElement("div");
  row.className = "message " + type;

  if (type === "assistant") {
    const avatar = document.createElement("div");
    avatar.className = "avatar";
    avatar.textContent = "Z";
    row.appendChild(avatar);
  }

  const bubble = document.createElement("div");
  bubble.className = "bubble";

  if (fileName && type === "user") {
    const attachment = document.createElement("div");
    attachment.className = "attachment";
    attachment.textContent = "📎 " + fileName;
    bubble.appendChild(attachment);
  }

  const paragraph = document.createElement("p");
  paragraph.textContent = text;
  bubble.appendChild(paragraph);
  row.appendChild(bubble);
  chat.appendChild(row);
  scrollBottom();
}

function addAssistantContent(title, paragraphs, listItems) {
  hideWelcome();

  const row = document.createElement("div");
  row.className = "message assistant";

  const avatar = document.createElement("div");
  avatar.className = "avatar";
  avatar.textContent = "Z";

  const bubble = document.createElement("div");
  bubble.className = "bubble";

  const heading = document.createElement("h3");
  heading.textContent = title;
  bubble.appendChild(heading);

  paragraphs.forEach(function(text) {
    const p = document.createElement("p");
    p.textContent = text;
    bubble.appendChild(p);
  });

  if (listItems && listItems.length) {
    const ul = document.createElement("ul");
    listItems.forEach(function(text) {
      const li = document.createElement("li");
      li.textContent = text;
      ul.appendChild(li);
    });
    bubble.appendChild(ul);
  }

  row.append(avatar, bubble);
  chat.appendChild(row);
  scrollBottom();
}

function demoReply(question, fileName) {
  const q = question.toLowerCase();

  if (fileName) {
    addAssistantContent(
      "Report upload prototype",
      [
        "Your file was selected in this browser, but its contents have not been read or analyzed.",
        "Automatic PDF extraction, image OCR, and validated report interpretation are not connected yet."
      ],
      [
        "You can type a test name and its value in the chat.",
        "Include the units and the reference range printed by the laboratory.",
        "For personal medical decisions, discuss the report with a healthcare professional."
      ]
    );
    return;
  }

  if (q.includes("cbc") || q.includes("blood count")) {
    addAssistantContent("What is a CBC test?", [
      "A Complete Blood Count (CBC) measures several components of blood.",
      "It commonly includes red blood cells, white blood cells, hemoglobin, hematocrit, and platelets."
    ], [
      "Hemoglobin helps carry oxygen.",
      "White blood cells are involved in immune defense.",
      "Platelets help blood clot.",
      "Results must be interpreted with the laboratory's ranges and your clinical context."
    ]);
  } else if (q.includes("glucose") || q.includes("sugar")) {
    addAssistantContent("Understanding blood glucose", [
      "A blood glucose test measures the amount of glucose in your blood.",
      "Interpretation depends on whether the sample was fasting, random, or taken after a meal, and on the test used."
    ], [
      "Check the units and the laboratory's reference information.",
      "A single result does not establish a diagnosis by itself.",
      "Discuss unexpected results with a healthcare professional."
    ]);
  } else if (q.includes("thyroid") || q.includes("tsh")) {
    addAssistantContent("Understanding thyroid tests", [
      "Thyroid testing may include TSH and thyroid hormones such as free T4.",
      "These tests help healthcare professionals evaluate thyroid function. Their interpretation depends on the test, reference range, medicines, and medical history."
    ], [
      "Check the exact test name and units.",
      "Review results with your healthcare professional, especially if you have symptoms or take thyroid medication."
    ]);
  } else if (q.includes("reference range") || q.includes("normal range")) {
    addAssistantContent("What is a reference range?", [
      "A reference range is a comparison interval provided by a laboratory for a particular test.",
      "A value outside that interval does not automatically mean disease, and a value inside it does not guarantee that everything is healthy."
    ], [
      "Use the range printed on your own report.",
      "Check units carefully.",
      "Interpret results alongside symptoms, history, and other findings."
    ]);
  } else if (q.includes("high cholesterol") || q.includes("lipid")) {
    addAssistantContent("Understanding a lipid profile", [
      "A lipid profile commonly measures total cholesterol, LDL cholesterol, HDL cholesterol, and triglycerides.",
      "Their interpretation depends on the individual and overall cardiovascular risk."
    ], [
      "Review each value and its units.",
      "Ask your clinician how your results relate to your personal risk factors.",
      "Do not start or stop medication based on this demo."
    ]);
  } else if (q.trim() === "") {
    addAssistantContent("How can I help?", [
      "Enter a question about a laboratory test, its units, or a reference range."
    ]);
  } else {
    addAssistantContent("Medical education demo", [
      "I received your question: " + question,
      "This website currently uses predefined demonstration responses, not a live AI model.",
      "To answer this specific question reliably, the next development step is to connect a medical knowledge source and an AI backend with appropriate safety controls."
    ], [
      "Share the exact laboratory test name if you have one.",
      "Include the reported value, unit, and reference interval when relevant.",
      "Avoid entering personal identifiers such as your name, address, or patient ID."
    ]);
  }
}

function sendMessage() {
  const text = input.value.trim();

  if (!text && !selectedFile) {
    input.focus();
    return;
  }

  const fileName = selectedFile ? selectedFile.name : null;

  addMessage(
    text || "Please help me understand this selected report.",
    "user",
    fileName
  );

  input.value = "";
  input.style.height = "auto";

  const hadFile = !!fileName;
  selectedFile = null;
  fileInput.value = "";
  filePreview.style.display = "none";
  filePreview.textContent = "";

  // Local demonstration only: no network request is made.
  window.setTimeout(function() {
    demoReply(text, hadFile ? fileName : null);
  }, 350);
}

document.getElementById("sendButton").addEventListener("click", sendMessage);

input.addEventListener("keydown", function(event) {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    sendMessage();
  }
});

input.addEventListener("input", function() {
  input.style.height = "auto";
  input.style.height = Math.min(input.scrollHeight, 140) + "px";
});

document.getElementById("attachButton").addEventListener("click", function() {
  fileInput.click();
});

document.getElementById("uploadButton").addEventListener("click", function() {
  fileInput.click();
  sidebar.classList.remove("open");
});

fileInput.addEventListener("change", function() {
  const file = fileInput.files[0];
  if (!file) return;

  const allowed = /\.(pdf|png|jpe?g|txt)$/i.test(file.name);

  if (!allowed) {
    alert("Choose a PDF, PNG, JPEG, or text file.");
    fileInput.value = "";
    return;
  }

  if (file.size > 10 * 1024 * 1024) {
    alert("The maximum file size is 10 MB.");
    fileInput.value = "";
    return;
  }

  selectedFile = file;
  filePreview.style.display = "block";
  filePreview.textContent =
    "📎 Selected: " + file.name +
    " · " + (file.size / 1024).toFixed(1) + " KB" +
    " · Contents not yet analyzed";
});

document.getElementById("newChat").addEventListener("click", function() {
  chat.innerHTML = "";
  chat.append(welcome, features, promptTitle, prompts);

  welcome.classList.remove("hidden");
  features.classList.remove("hidden");
  promptTitle.classList.remove("hidden");
  prompts.classList.remove("hidden");

  selectedFile = null;
  fileInput.value = "";
  filePreview.style.display = "none";
  filePreview.textContent = "";
  input.value = "
